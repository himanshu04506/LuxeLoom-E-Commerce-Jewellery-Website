# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/luxeloom
JWT_SECRET=

# Metal Rate API Key (Optional live gold API key - fallback data included)
METAL_API_KEY=your_gold_api_key_here

# Razorpay Integration (Test mode fallback enabled)
RAZORPAY_KEY_ID=rzp_test_luxeloom12345
RAZORPAY_KEY_SECRET=

# Google Maps API Key (Interactive canvas fallback enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email SMTP Settings (Mock fallback enabled if invalid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@luxeloom.com
SMTP_PASS=your_smtp_app_password
FROM_EMAIL="LuxeLoom Jewellery" <no-reply@luxeloom.com>

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
